+            ggml_set_name(gate, "gate"); ggml_set_name(resid, "resid");
+            out = ggml_add(ctx, resid, ggml_mul(ctx, out, gate));
+        }
+        ggml_set_name(out, "out");
+        return out;
+    }
+};
