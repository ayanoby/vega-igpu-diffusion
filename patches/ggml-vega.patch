+static int ggml_vk_match_norm_affine(const struct ggml_cgraph * cgraph, int node_idx, ggml_op norm_op, bool silu, int idxs[4]) {
+    const ggml_op ops[4] = { norm_op, GGML_OP_MUL, GGML_OP_ADD, GGML_OP_UNARY };
